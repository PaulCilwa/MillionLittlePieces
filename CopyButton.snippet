<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Copy Button</Title>
      <Shortcut>copybtn</Shortcut>
      <Description>Inserts a CopyButton HTML element</Description>
      <Author>Paul</Author>
    </Header>

    <Snippet>
      <Code Language="HTML">
        <![CDATA[
<button class="CopyButton">Copy</button>
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
