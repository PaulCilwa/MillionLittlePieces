       </div>

        <footer>
            <asp:Literal id="lit_CopyrightNotice" runat=server />
	    </footer>
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const video = entry.target;
                    if (entry.isIntersecting) {
                        video.play();
                    } else {
                        video.pause();
                    }
                });
            }, { threshold: 0.5 });

            document.querySelectorAll("video").forEach(video => {
                video.setAttribute("playsinline", "");
                video.setAttribute("loop", "");
                observer.observe(video);
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('SidebarToggle'),
                sidebar = document.getElementById('Sidebar');

            if (!toggle || !sidebar) {
                console.warn('SidebarToggle or Sidebar not found');
                return;
            }

            // collapse/expand
            function toggleSidebar(e) {
                e.preventDefault();
                // flip between none and block
                sidebar.style.display =
                    window.getComputedStyle(sidebar).display === 'none'
                        ? 'block'
                        : 'none';
            }

            // Remove any old handlers just in case
            toggle.replaceWith(toggle.cloneNode(true));
            toggle = document.getElementById('SidebarToggle');

            // Listen for pointerup (fires for taps and clicks alike)
            toggle.addEventListener('pointerup', toggleSidebar);

            // Ensure initial visibility on load + resize
            function updateVisibility() {
                if (window.innerWidth <= 1024) {
                    sidebar.style.display = 'none';
                    toggle.style.display = 'block';
                } else {
                    sidebar.style.display = 'block';
                    toggle.style.display = 'none';
                }
            }
            window.addEventListener('resize', updateVisibility);
            updateVisibility();
        });
    </script>

</body>
</html>
