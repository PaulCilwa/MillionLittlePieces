<div id=Extract class=BirthGirl>
	<table class=Milestone>
		<tr><th>Milestone:</th><td>Birth</td></tr>
		<tr><th>Who:</th><td>Karen Hope Cilwa</td></tr>
		<tr><th>Date and time:</th><td>January 30, 1974 3:30 PM</td></tr>
		<tr><th>Father:</th><td><a href="../../About_Me">Paul Sigmund Cilwa</a></td></tr>
		<tr><th>Mother:</th><td><a href="../1948-09-27.Mary">Mary Ann Steinberg Cilwa</a></td></tr>
