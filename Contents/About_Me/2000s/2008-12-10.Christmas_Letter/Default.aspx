	<div class=PhotoRow4>
		<%
			ThisPage.MakeFigure("/Contents/About_My_Family/1973-02-19.Dorothy/2008-05-10.Wedding_To_Frank/Kinders.jpg", "Kathy and Joe Kinder, parents of the groom.")
